# Copy this file to okta.env, fill in real values, then:
#   source okta.env && ./collect-okta.sh --out /tmp/self-test-okta-runtime
#
# okta.env itself is gitignored - never commit real credentials.

export OKTA_ORG_URL=https://your-org.okta.com
export OKTA_CLIENT_ID=changeme
export OKTA_PRIVATE_KEY=/path/to/your-key.pem
# export OKTA_KEY_ID=changeme  # only if the app has more than one key
